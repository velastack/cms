{
	"name": "@velastack/cms",
	"version": "0.1.0",
	"description": "A scope-aware CMS for SvelteKit, for static or dynamic sites.",
	"keywords": [
		"svelte",
		"sveltekit",
		"cms",
		"content",
		"editing",
		"vite-plugin",
		"velastack"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/velastack/cms.git"
	},
	"homepage": "https://github.com/velastack/cms#readme",
	"bugs": {
		"url": "https://github.com/velastack/cms/issues"
	},
	"type": "module",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && node scripts/build-admin-bar-css.js && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"plugin/src/**/*.ts",
		"plugin/src/**/*.js",
		"!plugin/src/**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./srv": {
			"types": "./dist/srv/index.d.ts",
			"default": "./dist/srv/index.js"
		},
		"./vite": {
			"types": "./plugin/src/index.ts",
			"default": "./plugin/src/index.ts"
		},
		"./adapter": {
			"default": "./plugin/src/adapter.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"marked": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0",
		"svelte": "^5.0.0",
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"marked": {
			"optional": true
		}
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.38.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.4.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"marked": "^18.0.11",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-meta-tags": "^5.0.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@tiptap/core": "^3.30.6",
		"@tiptap/extension-link": "^3.30.6",
		"@tiptap/pm": "^3.30.6",
		"@tiptap/starter-kit": "^3.30.6"
	}
}
