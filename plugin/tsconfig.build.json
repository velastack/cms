{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"allowJs": true,
		"checkJs": false,
		"sourceMap": true
	},
	"include": ["src/**/*"],
	"exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**", "src/fallback-shim.js"]
}
