	"page:/(marketing)/about": {
		"metadata": {
			"title": "About",
			"description": "A net-maker’s house turned into a hotel."
		},
		"hero": {
			"title": "A net-maker’s house"
		},
		"story": "<p>For a hundred years this house was where the harbour’s nets were made and mended. Lúcia’s grandfather was the last net-maker. In 2016 she and Mateo turned his workshop into a terrace and the lofts into rooms.</p><p>One of his nets still hangs in reception.</p>",
		"storyImage": {
			"url": "/demo/reception.jpg",
			"alt": "The reception desk"
		},
		"history": {
			"items": [
				{
					"id": "1921",
					"date": "1921",
					"title": "The net-maker’s house",
					"body": "<p>Built on the harbour wall.</p>"
				},
				{
					"id": "2016",
					"date": "2016",
					"title": "Casa Marea opens",
					"body": "<p>Four rooms and a terrace.</p>"
				},
				{
					"id": "2022",
					"date": "2022",
					"title": "The Loft",
					"body": "<p>The roof space becomes our family room.</p>"
				},
				{
					"id": "2025",
					"date": "2025",
					"title": "The wood oven",
					"body": "<p>Dinner twice a week in the courtyard.</p>"
				}
			]
		},
		"team": {
			"items": [
				{
					"id": "lucia",
					"name": "Lúcia Faria",
					"role": "Owner",
					"bio": "<p>Grew up in this house. Knows every fisherman by name.</p>",
					"photo": {
